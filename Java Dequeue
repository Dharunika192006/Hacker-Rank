import java.util.*;

public class test {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        Deque<Integer> deque = new ArrayDeque<>();
        HashSet<Integer> set = new HashSet<>();
        
        int n = in.nextInt();
        int m = in.nextInt();
        int maxUnique = 0;

        for (int i = 0; i < n; i++) {
            int num = in.nextInt();
            
            // Add current number to deque and set
            deque.add(num);
            set.add(num);
            
            // Once the window reaches size M
            if (deque.size() == m) {
                // Update maxUnique if current set size is larger
                if (set.size() > maxUnique) {
                    maxUnique = set.size();
                }
                
                // If we already found the maximum possible unique count, we can stop early
                if (maxUnique == m) break;

                // Remove the first element to slide the window
                int first = deque.removeFirst();
                
                // Only remove from set if the value doesn't exist elsewhere in the current window
                if (!deque.contains(first)) {
                    set.remove(first);
                }
            }
        }
        
        System.out.println(maxUnique);
    }
}
