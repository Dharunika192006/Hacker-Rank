import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution{
	public static void main(String[] args){
		
		Scanner in = new Scanner(System.in);
		int testCases = Integer.parseInt(in.nextLine());
		while(testCases>0){
			String line = in.nextLine();
			// Regex explanation:
            // <(.+)> matches the start tag and saves name in group 1
            // ([^<]+) matches content that doesn't contain another start tag
            // </\\1> matches the closing tag using the name from group 1
            String regex = "<(.+)>([^<]+)</\\1>";
            Pattern p = Pattern.compile(regex);
            Matcher m = p.matcher(line);
            
            boolean found = false;
            while (m.find()) {
                // Print the content found in Group 2
                System.out.println(m.group(2));
                found = true;
            }
            
            if (!found) {
                System.out.println("None");
            }
        
			testCases--;
		}
	}
}



